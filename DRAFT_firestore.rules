rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Shared Hardened Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data, projectId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'schemaVersion', 'code', 'name', 'status', 'stage',
          'client', 'owner', 'address', 'municipality', 'state',
          'site', 'urbanRules', 'constructionMethod', 'floors', 'unitTypes',
          'structuralElements', 'rainwaterElements', 'rainwaterConfig',
          'electricalHeights', 'hydraulicConfig', 'professionals',
          'budgetEntries', 'budgetSettings', 'normativeRefs',
          'renderSettings', 'memorialOverrides', 'revisions',
          'fireSafetyNotes', 'accessibilityConfig', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'schemaVersion', 'code', 'name', 'status', 'stage',
          'client', 'owner', 'address', 'municipality', 'state',
          'site', 'urbanRules', 'constructionMethod', 'floors', 'unitTypes',
          'structuralElements', 'rainwaterElements', 'rainwaterConfig',
          'electricalHeights', 'hydraulicConfig', 'professionals',
          'budgetEntries', 'budgetSettings', 'normativeRefs',
          'renderSettings', 'memorialOverrides', 'revisions',
          'fireSafetyNotes', 'accessibilityConfig', 'implantation',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == projectId
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.schemaVersion is number
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 48
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.status in ['em_andamento', 'concluido', 'arquivado']
        && data.stage in [
          'estudo_conceitual', 'estudo_preliminar', 'anteprojeto',
          'aprovacao', 'executivo', 'dimensionado', 'revisado', 'validado_rt'
        ]
        && data.client is string && data.client.size() <= 160
        && data.owner is string && data.owner.size() <= 160
        && data.address is string && data.address.size() <= 240
        && data.municipality is string && data.municipality.size() <= 120
        && data.state is string && data.state.size() <= 8
        && data.site is map
        && data.urbanRules is list && data.urbanRules.size() <= 40
        && data.constructionMethod is map
        && data.floors is list && data.floors.size() <= 20
        && data.unitTypes is list && data.unitTypes.size() <= 30
        && data.structuralElements is list && data.structuralElements.size() <= 600
        && data.rainwaterElements is list && data.rainwaterElements.size() <= 100
        && data.rainwaterConfig is map
        && data.electricalHeights is map
        && data.hydraulicConfig is map
        && data.professionals is list && data.professionals.size() <= 20
        && data.budgetEntries is list && data.budgetEntries.size() <= 250
        && data.budgetSettings is map
        && data.normativeRefs is list && data.normativeRefs.size() <= 50
        && data.renderSettings is map
        && data.memorialOverrides is map
        && data.revisions is list && data.revisions.size() <= 100
        && data.fireSafetyNotes is map
        && data.accessibilityConfig is map
        && (!('implantation' in data) || data.implantation is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectRender(data, projectId, renderId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'projectId', 'title', 'preset', 'timeOfDay',
          'dataUrl', 'capturedAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'projectId', 'title', 'preset', 'timeOfDay',
          'dataUrl', 'capturedAt', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == renderId
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.projectId)
        && data.projectId == projectId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.preset is string && data.preset.size() >= 1 && data.preset.size() <= 40
        && data.timeOfDay is string && data.timeOfDay.size() >= 1 && data.timeOfDay.size() <= 24
        && data.dataUrl is string && data.dataUrl.size() >= 1 && data.dataUrl.size() <= 750000
        && data.capturedAt is string && data.capturedAt.size() >= 1 && data.capturedAt.size() <= 64
        && data.createdAt is timestamp;
    }

    // 3. Private User Profile Collection (/users/{userId})
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if false;
    }

    // 4. Projects Root Collection (/projects/{projectId})
    match /projects/{projectId} {
      allow get: if isSignedIn()
        && isValidId(projectId)
        && (resource == null || existing().ownerId == request.auth.uid);

      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(projectId)
        && isValidProject(incoming(), projectId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(projectId)
        && isValidProject(incoming(), projectId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'schemaVersion', 'code', 'name', 'status', 'stage',
          'client', 'owner', 'address', 'municipality', 'state',
          'site', 'urbanRules', 'constructionMethod', 'floors', 'unitTypes',
          'structuralElements', 'rainwaterElements', 'rainwaterConfig',
          'electricalHeights', 'hydraulicConfig', 'professionals',
          'budgetEntries', 'budgetSettings', 'normativeRefs',
          'renderSettings', 'memorialOverrides', 'revisions',
          'fireSafetyNotes', 'accessibilityConfig', 'implantation', 'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;

      // 5. Subcollection: 3D Perspective Renders (/projects/{projectId}/renders/{renderId})
      match /renders/{renderId} {
        allow get: if isSignedIn()
          && isValidId(projectId)
          && isValidId(renderId)
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;

        allow list: if isSignedIn()
          && existing().ownerId == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(projectId)
          && isValidId(renderId)
          && isValidProjectRender(incoming(), projectId, renderId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;

        allow update: if false;

        allow delete: if isSignedIn()
          && isValidId(projectId)
          && isValidId(renderId)
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
